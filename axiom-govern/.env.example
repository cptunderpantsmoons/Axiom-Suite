# Management Harness environment template.
# Copy to .env and adjust, or export these as MH_* environment variables.

# Server
MH_SERVER_HOST=0.0.0.0
MH_SERVER_PORT=8080

# Proxy
MH_PROXY_ENABLED=true
MH_PROXY_DEFAULT_PROVIDER=kilo
MH_PROXY_REQUIRE_AUTH=true

# Manager API
MH_MANAGER_ENABLED=true
MH_MANAGER_HOST=0.0.0.0
MH_MANAGER_PORT=8090
MH_MANAGER_ADMIN_TOKEN=change-me-admin-token
MH_MANAGER_JWT_SECRET=change-me-jwt-secret
MH_MANAGER_WEB_ENABLED=true

# Redis (set MH_REDIS_ENABLED=true to share API keys, budgets, and usage
# counters across the proxy and manager processes)
MH_REDIS_ENABLED=false
MH_REDIS_ADDR=localhost:6379
MH_REDIS_PASSWORD=
MH_REDIS_DB=0

# Providers
MH_PROVIDERS_OPENAI_TYPE=openai
MH_PROVIDERS_OPENAI_API_KEY=sk-your-key
MH_PROVIDERS_OPENAI_BASE_URL=https://api.openai.com/v1
MH_PROVIDERS_OPENAI_ENABLED=false

MH_PROVIDERS_ANTHROPIC_TYPE=anthropic
MH_PROVIDERS_ANTHROPIC_API_KEY=sk-ant-your-key
MH_PROVIDERS_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
MH_PROVIDERS_ANTHROPIC_ENABLED=false

# --- Default Kilo AI Gateway route (OpenAI-compatible) ---
# Current Kilo docs require a Kilo API key and use this base URL without /v1.
MH_PROVIDERS_KILO_TYPE=openai
MH_PROVIDERS_KILO_API_KEY=
MH_PROVIDERS_KILO_BASE_URL=https://api.kilo.ai/api/gateway
MH_PROVIDERS_KILO_ENABLED=true
# OpenCode Zen: always-free KEYLESS models like opencode/hy3-free on /chat/completions.
MH_PROVIDERS_OPENCODE_TYPE=openai
MH_PROVIDERS_OPENCODE_API_KEY=
MH_PROVIDERS_OPENCODE_BASE_URL=https://opencode.ai/zen/v1
MH_PROVIDERS_OPENCODE_ENABLED=false

# NVIDIA NIM (OpenAI-compatible) — for prompt optimisation + skill drafting
MH_PROVIDERS_NVIDIA_TYPE=openai
MH_PROVIDERS_NVIDIA_API_KEY=
MH_PROVIDERS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MH_PROVIDERS_NVIDIA_ENABLED=true

# Optimizer / skill wizard (uses NVIDIA Nemotron when its key is configured)
MH_OPTIMIZER_ENABLED=true
MH_OPTIMIZER_PROVIDER=nvidia
MH_OPTIMIZER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MH_OPTIMIZER_SHADOW_MODE=false

# Provenance (Proof of Source / Proof of Human) — optional persistent Ed25519 key.
# base64 of the raw 64-byte private key; if empty an ephemeral key is used.
# MH_PROVENANCE_PRIVATE_KEY=

# Guardian
MH_GUARDIAN_ENABLED=true
MH_GUARDIAN_BLOCK_INJECTION=true
MH_GUARDIAN_BLOCK_JAILBREAK=true
MH_GUARDIAN_REDACT_PII=true

# Metrics
MH_METRICS_ENABLED=true
MH_METRICS_PORT=9091
MH_METRICS_PATH=/metrics

# Logging
MH_LOGGING_LEVEL=info
MH_LOGGING_FORMAT=json

# Audit persistence (optional; events/chain are in-memory by default)
# MH_AUDIT_FILE=/var/log/harness/audit.jsonl
# MH_AUDIT_CHAIN_FILE=/var/log/harness/chain.hash
