# Stripe test-mode credentials. Never commit real values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Recurring Price IDs created in Stripe Dashboard or by the uploaded stripe-agent skill.
# STRIPE_PRICE_ID is retained as a backwards-compatible Builder fallback.
